-- Ejercicio 2: Utilizando JOIN realizarás las siguientes consultas:

-- 2.1. Listado de los países que están generando ventas.
SELECT country AS paises_exportadores
FROM company
JOIN transaction ON company.id = transaction.company_id
WHERE transaction.declined = "0"
GROUP BY country
ORDER BY country;

-- 2.2. Desde cuántos países se generan las ventas.
SELECT COUNT(DISTINCT company.country) AS cant_paises_export
FROM company
JOIN transaction ON company.id = transaction.company_id
WHERE transaction.declined = "0";

-- 2.3. Identifica a la compañía con la mayor media de ventas.
SELECT company_name AS compañia_top, ROUND(AVG(transaction.amount), 2) AS media_ventas
FROM company
JOIN transaction ON company.id = transaction.company_id
WHERE transaction.declined = "0"
GROUP BY company_name
ORDER BY media_ventas DESC
LIMIT 1;

